{
  "delimiter": "auto",
  "encoding": "utf-8",
  "has_header": true,
  "date_from_filename": true,
  "filename_date_regex": "(\\d{8})",
  "columns": {
    "date": ["date", "trade_date", "trading_date", "日期", "交易日期"],
    "symbol": ["symbol", "ts_code", "wind_code", "code", "ticker", "证券代码", "股票代码", "代码"],
    "exchange": ["exchange", "market", "交易所", "市场"],
    "open": ["open", "open_price", "开盘", "开盘价"],
    "high": ["high", "high_price", "最高", "最高价"],
    "low": ["low", "low_price", "最低", "最低价"],
    "close": ["close", "close_price", "收盘", "收盘价"],
    "volume": ["volume", "vol", "成交量"],
    "amount": ["amount", "turnover", "成交额"]
  },
  "exchange_suffixes": {
    "SZ": [".SZ", ".SZE", ".XSHE", "SZ", "SZE", "XSHE"],
    "SH": [".SH", ".SSE", ".XSHG", "SH", "SSE", "XSHG"]
  }
}

