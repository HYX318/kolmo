# Canonical market-data directory, kept outside the source tree.
KOLMO_DATA_ROOT="$HOME/dat/all"

# Personal Tiingo API token. Keep the real value only in the ignored .env file.
TIINGO_API_TOKEN=""

# Required identity for SEC EDGAR automated access, for example:
# Kolmo research-data your-real-address@example.com
SEC_USER_AGENT=""
